<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!--
        Backups live in shared storage (/sdcard/RedTerm) specifically so they
        survive uninstalling the app; Android wipes app-specific storage on
        uninstall, which would destroy a backup at the moment the user reinstalls
        in order to restore it. Reading and writing that folder requires the
        all-files grant. ScopedStorage is flagged because the permission is
        broader than the app strictly needs, which is the accepted trade-off for
        backups that outlive the app.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".RedTermApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.RedTermApp"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules_legacy">

        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.RedTermApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.TerminalActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.AppLogActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.RecordingActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.RecordingPlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.BackupManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.BaseImageUpdateActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.SshManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.SshKeysActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.filelist.SftpBrowserActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.DiskUsageActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.PackageUpdateActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.TextEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.DistroDiagnosticsActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.FileBrowserActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.FileViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <activity
            android:name=".ui.BashTemplatesActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <service
            android:name=".ui.QuickSettingsTile"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="RedTerm"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".ui.NightModeReceiver"
            android:exported="false" />

        <activity
            android:name=".ui.WidgetConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.RedTermApp" />

        <receiver
            android:name=".ui.RedTermWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".util.CancelReceiver"
            android:exported="false" />

        <service
            android:name=".service.TerminalService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps active terminal and proot sessions running while RedTerm is in the background" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

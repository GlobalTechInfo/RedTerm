<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/diag_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/terminalBg"
        app:popupTheme="@style/ThemeOverlay.Material3.Dark"
        android:theme="@style/ThemeOverlay.Material3.Dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/diag_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/terminalText"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diag_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/terminalText"
            android:textSize="11sp"
            android:alpha="0.65" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/diag_checks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp" />

    </ScrollView>

    <TextView
        android:id="@+id/diag_copy"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/action_copy"
        android:textColor="?attr/colorPrimary"
        android:textSize="14sp"
        android:background="?attr/terminalBg"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>

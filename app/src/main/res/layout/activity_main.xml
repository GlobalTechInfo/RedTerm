<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/terminalBg"
    android:fitsSystemWindows="true">

    <ImageButton
        android:id="@+id/main_back_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_back_chip"
        android:scaleType="centerInside"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="10dp" />

    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a distro to launch"
        android:textColor="?attr/terminalText"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/main_back_btn"
        app:layout_constraintBottom_toBottomOf="@id/main_back_btn"
        app:layout_constraintStart_toEndOf="@id/main_back_btn"
        app:layout_constraintEnd_toStartOf="@id/settings_gear" />

    <ImageButton
        android:id="@+id/settings_gear"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_gear"
        android:scaleType="centerInside"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        android:tint="?attr/terminalText"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/welcome_text"
        app:layout_constraintBottom_toTopOf="@id/settings_button">

        <LinearLayout
            android:id="@+id/distro_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/settings_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/settings"
        android:textAllCaps="false"
        android:backgroundTint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_distro_button"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:icon="@drawable/ic_home"
        app:iconTint="?attr/colorOnPrimary"
        app:iconSize="24dp"
        app:backgroundTint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/settings_button"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/new_session_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/new_session"
        android:textAllCaps="false"
        android:backgroundTint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

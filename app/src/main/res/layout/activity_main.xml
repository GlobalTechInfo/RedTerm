<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ImageButton
        android:id="@+id/main_back_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_back_chip"
        android:scaleType="centerInside"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="10dp" />

    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_distro_to_launch"
        android:textColor="?attr/terminalText"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/main_back_btn"
        app:layout_constraintBottom_toBottomOf="@id/main_back_btn"
        app:layout_constraintStart_toEndOf="@id/main_back_btn"
        app:layout_constraintEnd_toStartOf="@id/settings_gear" />

    <ImageButton
        android:id="@+id/settings_gear"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_gear"
        android:scaleType="centerInside"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        app:tint="?attr/terminalText"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/welcome_text"
        app:layout_constraintBottom_toTopOf="@+id/bottom_buttons">

        <LinearLayout
            android:id="@+id/distro_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!--
      Settings, Add distro and New session were three siblings each constrained to
      the parent's start, with Add distro also centred, so they were drawn on top of
      each other. A row of three equally weighted buttons cannot overlap, and cannot
      run off the right edge either: wrap_content plus spacers overflowed once the
      labels and the icon were laid out, which clipped "New session" to "Ne".
    -->
    <LinearLayout
        android:id="@+id/bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_button"
            style="@style/Widget.RedTermApp.HomeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_distro_button"
            style="@style/Widget.RedTermApp.HomeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/add_distro"
            app:icon="@drawable/ic_add_distro"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/new_session_button"
            style="@style/Widget.RedTermApp.HomeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/new_session" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  No android:background here on purpose: the press ripple is attached in code
  (see FileBrowserActivity.RowAdapter) so the row does not paint a background on
  top of the window background, and the click target is the row itself.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_click_target"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:paddingStart="14dp"
    android:paddingEnd="4dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/row_icon"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:gravity="center"
        android:textColor="?attr/terminalText" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="7dp"
        android:paddingStart="0dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/terminalText"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/row_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/terminalText"
            android:textSize="11sp"
            android:alpha="0.6"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/row_actions"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/file_actions_for"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:src="@drawable/ic_more_vert"
        android:scaleType="centerInside" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/terminalBg"
            app:popupTheme="@style/ThemeOverlay.Material3.Dark"
            android:theme="@style/ThemeOverlay.Material3.Dark" />

        <LinearLayout
            android:id="@+id/search_panel"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="?attr/extraKeysBg"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Search..."
                android:textColor="?attr/terminalText"
                android:textColorHint="#66CDD6F4"
                android:textSize="13sp"
                android:background="@null"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <TextView
                android:id="@+id/search_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0"
                android:textColor="?attr/terminalText"
                android:textSize="11sp"
                android:alpha="0.5"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/search_prev"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="\u25B2"
                android:textColor="?attr/terminalText"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/search_next"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="\u25BC"
                android:textColor="?attr/terminalText"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/search_close"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="\u2715"
                android:textColor="?attr/terminalText"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:imeOptions="actionNone|flagNoEnterAction" />

            <com.redtermapp.ui.SearchHighlightOverlay
                android:id="@+id/search_highlight_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />

            <LinearLayout
                android:id="@+id/quick_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="?attr/extraKeysBg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quick Settings"
                        android:textColor="?attr/terminalText"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/panel_close"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✕"
                        android:textColor="?attr/terminalText"
                        android:textSize="16sp"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/panel_wakelock"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Wake lock"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_margin="2dp" />

                    <TextView
                        android:id="@+id/panel_font_up"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="A+"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_margin="2dp" />

                    <TextView
                        android:id="@+id/panel_font_down"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="A−"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_margin="2dp" />

                    <TextView
                        android:id="@+id/panel_reset"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Reset"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_margin="2dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3A3A4C" />

                <TextView
                    android:id="@+id/panel_swipe_hint"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:text="Swipe up to close"
                    android:textSize="10sp"
                    android:alpha="0.4" />

            </LinearLayout>

        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/extra_keys"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="?attr/extraKeysBg"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/extra_keys_container"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/extra_keys_row2"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="?attr/extraKeysBg"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/extra_keys_container_row2"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/terminalBg"
        android:orientation="vertical"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/extraKeysBg">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\u2630 Sessions"
                    android:textColor="?attr/terminalText"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/distro_size_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="?attr/terminalText"
                    android:textSize="10sp"
                    android:alpha="0.5" />
            </LinearLayout>

            <TextView
                android:id="@+id/session_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:alpha="0.7" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/session_list_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="4dp" />

        <TextView
            android:id="@+id/new_session_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="+ New Session"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:gravity="center"
            android:background="?attr/extraKeysBg"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
